# ─────────────────────────────────────────────────────────────
# ProofChain environment configuration
# Copy to .env and adjust. NEVER commit .env, private keys,
# seed phrases, or API tokens.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Default: zero-setup SQLite file (created automatically).
# For PostgreSQL: set provider = "postgresql" in apps/api/prisma/schema.prisma
# and use e.g. postgresql://user:pass@localhost:5432/proofchain
DATABASE_URL="file:./data/proofchain.db"

# ── Blockchain ──────────────────────────────────────────────
# Local Hardhat node (default). For Sepolia, point at your RPC
# endpoint and set CHAIN_ID=11155111.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
NETWORK_NAME=localhost

# Server-side signer used for demo mode and the "local dev signer"
# fallback when MetaMask is unavailable. The default below is
# Hardhat's PUBLICLY KNOWN dev account #0 — it holds no real value
# and must NEVER be used outside a local development chain.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Filled automatically by `npm run deploy` (written to
# blockchain/deployments/<network>.json and read from there).
# Set manually only when pointing at an existing deployment.
CONTRACT_ADDRESS=
CERTIFICATE_ADDRESS=

# Optional: public testnet deployment (never required for local dev).
# Set both, fund the PRIVATE_KEY account with Sepolia ETH, then run
# `npm run deploy:sepolia --workspace @proofchain/blockchain`.
SEPOLIA_RPC_URL=

# ── Storage / IPFS ──────────────────────────────────────────
# local  → content-addressed storage under ./storage (no external service)
# pinata → pin via Pinata (requires PINATA_JWT)
IPFS_MODE=local
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# ── AI service ──────────────────────────────────────────────
AI_SERVICE_URL=http://127.0.0.1:8000

# ── API ─────────────────────────────────────────────────────
API_PORT=4000
# Change in any non-throwaway environment.
JWT_SECRET=dev-only-change-me
# Upload limits
MAX_UPLOAD_MB=200
MAX_FILES_PER_ARTIFACT=2000
